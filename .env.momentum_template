# ==============================================================================
# MOMENTUM SCANNER CONFIGURATION TEMPLATE
# ==============================================================================
# Copy relevant sections to your .env file to enable momentum scanner
# DO NOT commit .env file to git (contains API keys)
# ==============================================================================

# ============ MOMENTUM SCANNER SETTINGS ============
# Enable/disable momentum scanner (independent of ML models)
MOMENTUM_SCANNER_ENABLED=false          # Set to 'true' to enable

# Minimum 24h volume in USDT ($1M default filters noise)
MOMENTUM_MIN_VOLUME_USDT=1000000

# Auto-trade settings
MOMENTUM_AUTO_TRADE=false               # false = alerts only, true = auto-trade
MOMENTUM_ALERT_THRESHOLD=7              # 7/10 filters = Telegram alert
MOMENTUM_TRADE_THRESHOLD=10             # 10/10 filters = auto-trade (strict!)

# Position limits
MOMENTUM_MAX_POSITIONS=3                # Max 3 momentum trades at once
MOMENTUM_POSITION_SIZE_PCT=2.0          # 2% of portfolio per trade

# Risk management
MOMENTUM_STOP_LOSS_PCT=7.0              # 7% stop loss
MOMENTUM_TAKE_PROFIT_PCT=14.0           # 14% take profit (2:1 R/R)

# ============ DEPLOYMENT PHASES ============
# Phase 1: Alerts Only (Start Here)
# MOMENTUM_SCANNER_ENABLED=true
# MOMENTUM_AUTO_TRADE=false
# DRY_RUN=true

# Phase 2: Dry-Run Auto-Trade
# MOMENTUM_SCANNER_ENABLED=true
# MOMENTUM_AUTO_TRADE=true
# DRY_RUN=true

# Phase 3: Live Auto-Trade (After Testing!)
# MOMENTUM_SCANNER_ENABLED=true
# MOMENTUM_AUTO_TRADE=true
# DRY_RUN=false
# MOMENTUM_TRADE_THRESHOLD=10    # Require perfect 10/10

# ============ EXISTING SETTINGS (keep these) ============
# BINANCE_API_KEY=your_key
# BINANCE_API_SECRET=your_secret
# TRADING_MODE=live
# SYMBOL=BTCUSDT
# TIMEFRAME=5m
# DRY_RUN=false
# POSITION_SIZE_PERCENTAGE=5
# STOP_LOSS_PERCENTAGE=8.0
# TAKE_PROFIT_PERCENTAGE=999.0
# MAX_POSITION_SIZE=100
# SYMBOLS=ALL
# TELEGRAM_TOKEN=your_token
# TELEGRAM_CHAT_ID=your_chat_id

# ============ NOTES ============
# - Scanner runs independently of ML models
# - Does NOT require trained models
# - Catches breakouts ML might miss (like DASH)
# - 10 anti-pump-and-dump filters
# - Conservative by design
# - Small position sizing (2%)
# - See MOMENTUM_SCANNER_DEPLOY.md for full docs
