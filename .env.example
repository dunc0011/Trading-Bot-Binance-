# Binance API Credentials
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Trading Configuration
TRADING_MODE=testnet  # testnet or live
SYMBOL=BTCUSDT
TIMEFRAME=1h

# Risk Management
MAX_POSITION_SIZE=100  # in USDT
STOP_LOSS_PERCENTAGE=2.0
TAKE_PROFIT_PERCENTAGE=5.0

# Bot Settings
DRY_RUN=true  # Set to false for live trading
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
STRATEGY=simple  # simple or ml_ema

# Database (optional)
DATABASE_URL=sqlite:///data/trading_bot.db

# ML Strategy Settings (only used with STRATEGY=ml_ema)
ML_MODEL_DIR=models/ml_ema
ML_PROBA_THRESHOLD=0.55
ML_TARGET_HORIZON=1
ML_TARGET_RETURN_THRESHOLD=0.001
ML_WFV_SPLITS=5

# Telegram Notifications (optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
